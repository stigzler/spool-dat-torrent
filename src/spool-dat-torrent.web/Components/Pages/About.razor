@page "/about"
@using System.Reflection

<PageTitle>About</PageTitle>

<div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 70vh; text-align: center;">
    <MudImage Src="/icon-128px.png" Alt="SpoolDatTorrent Icon" Height="128" Width="128" Style="object-fit: contain;" />
    <MudText Typo="Typo.h6" Class="mt-3" Style="font-family: 'Rubik', sans-serif; font-weight: 500;">SpoolDatTorrent</MudText>
    <MudText Typo="Typo.body2" Class="mt-1" Style="opacity: 0.8;">by stigzler</MudText>
    <MudText Typo="Typo.caption" Class="mt-1" Style="opacity: 0.6;">Version @AppVersionString</MudText>
    <MudLink Href="https://github.com/stigzler/spool-dat-torrent" Target="_blank" Class="mt-2">https://github.com/stigzler/spool-dat-torrent</MudLink>
</div>

@code {
    private string AppVersionString =>
        Assembly.GetExecutingAssembly().GetName().Version?.ToString(3) ?? "?";
}
