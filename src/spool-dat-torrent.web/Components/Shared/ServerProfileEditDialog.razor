@using SpoolDatTorrent.Core.Helpers
@using SpoolDatTorrent.Core.Services
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Class="mb-2 text-secondary">
                    Edit your BitTorrent server details according to its requirements. Different clients will need different permutations of username, password and API key. For example,
                    QBitTorrent only requires username/password OR API Key (latter recommended). 
                </MudText>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_name"
                              @bind-Value:after="HandleName"
                              Label="Profile Name"
                              Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="Profile.Host"
                              @bind-Value:after="ScheduleSave"
                              Label="Host"
                              HelperText="Base URL of the BitTorrent client WebUI, e.g. http://localhost:8080"
                              Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="long"
                                 @bind-Value="Profile.SpoolingCapGb"
                                 @bind-Value:after="ScheduleSave"
                                 Label="Spooling Cap (GB)"
                                 HelperText="Maximum total size of files downloaded in a single batch for this server."
                                 Min="1"
                                 Class="sdt-numeric"
                                 Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="Profile.Username"
                              @bind-Value:after="ScheduleSave"
                              Label="Username"
                              HelperText="Username for the BitTorrent Server"
                              Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="Profile.Password"
                              @bind-Value:after="ScheduleSave"
                              Label="Password"
                              InputType="InputType.Password"
                              HelperText="Password for the BitTorrent Server"
                              Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="Profile.ApiKey"
                              @bind-Value:after="ScheduleSave"
                              Label="API Key"
                              HelperText="Client API key fo the BitTorrent Server"
                              Variant="Variant.Outlined" FullWidth="true"
                              InputType="@(_showApiKey ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showApiKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="ToggleApiKeyVisibility"
                              AdornmentAriaLabel="Toggle API key visibility" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="BitTorrentClientType" @bind-Value="Profile.ClientType"
                           @bind-Value:after="ScheduleSave"
                           Label="Client Type"
                           Variant="Variant.Outlined" FullWidth="true">
                    @foreach (var type in Enum.GetValues<BitTorrentClientType>())
                    {
                        <MudSelectItem Value="@type">@type</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-3" />

        <MudText Typo="Typo.subtitle2" Class="mb-1">Docker path mapping (only for container installs)</MudText>
        <MudText Typo="Typo.caption" Class="mb-1">
            Only needed when your BitTorrent Client and SpoolDatTorrent run in separate containers that see the same disk at different paths. 
            If you mount the same host folder at the same path in both containers, leave both blank — no mapping is required.
        </MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="Profile.ClientDownloadsMapping.ClientVirtualPrefix"
                              @bind-Value:after="ScheduleSave"
                              Label="Path qBittorrent reports"
                              HelperText="The download path as the client API reports it, e.g. /downloads"
                              Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="Profile.ClientDownloadsMapping.AppVirtualPrefix"
                              @bind-Value:after="ScheduleSave"
                              Label="Same path as seen by SDT"
                              HelperText="The path SpoolDatTorrent uses for the same location. Leave both blank unless they differ."
                              Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="TestConnection" Disabled="_isTesting" StartIcon="@Icons.Material.Filled.Link">
            @(_isTesting ? "Testing..." : "Test")
        </MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public TorrentServerProfile Profile { get; set; } = default!;
    [Parameter] public string ProfileName { get; set; } = string.Empty;
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback<(string OldName, string NewName)> OnRename { get; set; }

    private string _name = string.Empty;
    private string _currentName = string.Empty;
    private bool _isTesting;
    private bool _showApiKey;
    private CancellationTokenSource? _debounce;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Block non-digit keys in the Spooling Cap field (class "sdt-numeric") so only
        // whole numbers can be typed. MudBlazor's numeric field only sanitizes on blur.
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/ServerProfileEditDialog.razor.js");
        await _module.InvokeVoidAsync("initNumericGuard");
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }

    private void ToggleApiKeyVisibility()
    {
        _showApiKey = !_showApiKey;
    }

    protected override void OnParametersSet()
    {
        _currentName = ProfileName;
        _name = ProfileName;
    }

    private void ScheduleSave()
    {
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(600, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(Persist);
                }
            }
            catch (OperationCanceledException)
            {
                // A newer edit superseded this save.
            }
        });
    }

    private void HandleName()
    {
        var newName = _name?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(newName))
        {
            _name = _currentName;
            Snackbar.Add("Profile name cannot be empty.", Severity.Warning);
            return;
        }

        if (string.Equals(newName, _currentName, StringComparison.Ordinal))
        {
            return;
        }

        _currentName = newName;
        _ = OnRename.InvokeAsync((ProfileName, newName));
        ScheduleSave();
    }

    private void Persist() => OnSave.InvokeAsync();

    private async Task TestConnection()
    {
        if (_isTesting) return;
        _isTesting = true;
        StateHasChanged();

        try
        {
            Logger.Log($"🧪 User testing server '{ProfileName}'...");
            StartupSummary.LogServerDetails(ProfileName, Profile);

            var httpClient = HttpClientFactory.CreateClient();
            var client = new QBitClient(httpClient, new GlobalSpoolSettings(), Profile);

            var ok = await client.AuthenticateAsync();
            Logger.Log(ok ? $"✅ Server test succeeded for '{ProfileName}' ({Profile.Host})." : $"❌ Server test failed for '{ProfileName}' ({Profile.Host}).");
            Snackbar.Add(ok ? $"Connected to '{Profile.Host}'." : $"Authentication failed for '{Profile.Host}'.", ok ? Severity.Success : Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError($"Server test failed for '{ProfileName}' ({Profile.Host}): {ex.Message}");
            Snackbar.Add($"Test failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isTesting = false;
            StateHasChanged();
        }
    }

    private void Close() => MudDialog.Close();
}
