@using SpoolDatTorrent.Core.Configuration
@using SpoolDatTorrent.Core.DTOs
@using SpoolDatTorrent.Core.Helpers
@inject GlobalSpoolSettings Settings

<MudCard Elevation="2" Class="mb-4">
    <div class="pa-4 pb-0">
        <div style="display: flex; align-items: center; width: 100%; justify-content: space-between; gap: 8px;">
            <div style="display: flex; align-items: center; min-width: 0; flex: 1 1 auto; gap: 8px;">
                <MudText Typo="Typo.h6" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@Stream.Name</MudText>
                @switch (Status)
                {
                    case "Active":
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Style="min-width: 96px; justify-content: center;">Active</MudChip>
                        break;
                    case "Paused":
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Style="min-width: 96px; justify-content: center;">Paused</MudChip>
                        break;
                    case "Completed":
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Style="min-width: 96px; justify-content: center;">Completed</MudChip>
                        break;
                    case "Error":
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Style="min-width: 96px; justify-content: center;">Error</MudChip>
                        break;
                }
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@ServerName</MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Style="white-space: nowrap; color: var(--mud-palette-text-secondary);">@Stream.Strategy</MudChip>
                @if (IsRateLimited)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" Style="white-space: nowrap;">Rate Limited</MudChip>
                }
                <MudText Typo="Typo.caption" Class="text-secondary" Style="white-space: nowrap;">@CreatedText</MudText>
                <MudText Typo="Typo.caption" Color="Color.Primary" Style="white-space: nowrap;">Spool Size Cap: @CapText</MudText>
            </div>
            <div style="display: flex; align-items: center; flex-shrink: 0; gap: 8px;">
                @if (IsCompleted)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="OnRemove" Style="white-space: nowrap; flex-shrink: 0; display: inline-flex; align-items: center;">Remove</MudButton>
                }
                else
                {
                    @if (GlobalPaused)
                    {
                        <MudText Typo="Typo.caption" Class="text-secondary" Style="white-space: nowrap; opacity: 0.7;">ⓘ Use Global resume in top bar</MudText>
                    }
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@ActionIcon" OnClick="OnStatusChange" Disabled="GlobalPaused" Style="white-space: nowrap; flex-shrink: 0; display: inline-flex; align-items: center;">@ActionLabel</MudButton>

                    <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="OnEdit" Style="white-space: nowrap; flex-shrink: 0; display: inline-flex; align-items: center;">Edit</MudButton>

                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close" OnClick="OnCancel" Style="white-space: nowrap; flex-shrink: 0; display: inline-flex; align-items: center;">Cancel</MudButton>
                }
            </div>
        </div>
        <div class="d-flex align-items-center" style="gap: 8px; min-width: 0;">
            <MudText Typo="Typo.body2" Style="opacity: 0.8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@DatName</MudText>
            @if (HasPriorityTerms || HasDePriorityTerms)
            {
                <div class="d-flex align-items-center" style="flex-shrink: 0; gap: 4px;">
                    @foreach (var term in PriorityTermList)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Style="white-space: nowrap;">@($"↑ {term}")</MudChip>
                    }
                    @foreach (var term in DePriorityTermList)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" Style="white-space: nowrap;">@($"↓ {term}")</MudChip>
                    }
                </div>
            }
        </div>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="text-secondary" />
            <MudText Typo="Typo.caption" Class="text-secondary" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                @DestinationText
            </MudText>
            @if (!string.IsNullOrWhiteSpace(Stream.SpoolingTargetOverride))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="ml-1">custom</MudChip>
            }
        </MudStack>
    </div>

    <MudCardContent>
        <MudStack Spacing="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    @if (Status == "Active")
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                    }
                    else
                    {
                        <MudIcon Icon="@StatusIcon" Color="@StatusIconColor" Size="Size.Small" />
                    }
                    <MudText Typo="Typo.h6">@ProgressPercent.ToString("0.#")%</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">(@MovedCount / @TotalCount files)</MudText>
                </MudStack>
                <MudText Typo="Typo.body2">@OverallSizeText</MudText>
            </MudStack>

            <MudProgressLinear Value="@ProgressPercent" Color="@ProgressColor" />

            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <MudText Typo="Typo.body2" Class="text-secondary" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    @StatusMessage
                </MudText>
            }
        </MudStack>
    </MudCardContent>

    <MudCardActions Class="p-2 flex-column">
        <div class="d-flex align-items-center w-100" style="flex-wrap: nowrap; gap: 4px;">
            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                       StartIcon="@(_expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                       OnClick="ToggleFiles"
                       Style="white-space: nowrap; flex-shrink: 0;">
                Files (@FileCount)
            </MudButton>
            @if (HasClientInfo)
            {
                <div class="ml-3" style="flex-shrink: 0; white-space: nowrap; width: 150px; text-align: right;">@ClientProgressPercent.ToString("0.#")% / @ClientSizeText</div>
                <div class="flex-grow-1 ml-3 mr-5" style="min-width: 60px;">
                    <MudProgressLinear Value="@ClientProgressPercent" Color="Color.Secondary" Class="w-100" />
                </div>
            }
        </div>
    </MudCardActions>

    @if (_expanded)
    {
        <MudCardContent Class="pt-0">
            @if (HasClientInfo)
            {
                <div class="d-flex align-items-center w-100 mb-3" style="flex-wrap: nowrap; gap: 12px; opacity: 0.7;">
                    @if (!string.IsNullOrWhiteSpace(ClientState))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Style="flex-shrink: 0; white-space: nowrap; width: 110px; justify-content: center;">@ClientState</MudChip>
                    }
                    <div class="ml-2" style="flex-shrink: 0; white-space: nowrap; width: 96px; text-align: center;">Seeds: @ClientSeedsText</div>
                    <div class="ml-2" style="flex-shrink: 0; white-space: nowrap; width: 96px; text-align: center;">Peers: @ClientPeersText</div>
                    <div class="ml-2" style="flex-shrink: 0; white-space: nowrap; min-width: 160px; text-align: center;">ETA: @ClientEtaText</div>
                    <div class="ml-2" style="flex-shrink: 0; white-space: nowrap; min-width: 96px; text-align: center;">Speed: @ClientSpeedText</div>
                </div>
            }
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.body2">Batch files</MudText>
                <MudSpacer />
                <MudSwitch T="bool" @bind-Value="_showDownloadingOnly" Label="Show only downloading" Color="Color.Primary" />
            </MudStack>

            @if (_visibleFiles.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="text-secondary">Preparing batch...</MudText>
            }
            else
            {
                <Virtualize TItem="FileProgressInfo" Items="_visibleFiles" Context="file" ItemSize="56">
                    <div class="d-flex align-items-center mb-2">
                        <div class="flex-grow-1 mr-2" style="min-width: 0;">
                            <div class="d-flex justify-content-between">
                                <MudText Typo="Typo.body2" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@file.Name</MudText>
                                <MudText Typo="Typo.body2" Class="ml-2">@file.Progress.ToString("P1")</MudText>
                            </div>
                            <MudProgressLinear Value="@(file.Progress * 100)" Color="Color.Primary" Class="mt-1" Style="height: 4px;" />
                        </div>
                        <MudText Typo="Typo.body2" Class="text-secondary ml-2" Style="white-space: nowrap;">@FileSizeText(file)</MudText>
                    </div>
                </Virtualize>
            }
        </MudCardContent>
    }
</MudCard>

@code {
    [Parameter] public StreamDetails Stream { get; set; } = default!;
    [Parameter] public StreamProgressInfo? Live { get; set; }

    [Parameter] public bool GlobalPaused { get; set; }

    [Parameter] public EventCallback OnStatusChange { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }

    private bool _expanded;
    private bool _showDownloadingOnly;

    private string Status => Live?.Status ?? Stream.Status;
    private bool IsCompleted => Status == "Completed";

    private string DatName
    {
        get
        {
            // Prefer the original DAT filename (the user's real name). Fall back to the
            // stored path, then the GUID cache/temp name as a last resort.
            string path = !string.IsNullOrWhiteSpace(Stream.OriginalDatPath)
                ? Stream.OriginalDatPath!
                : Stream.DatFilePath;
            return string.IsNullOrEmpty(path) ? string.Empty : System.IO.Path.GetFileName(path);
        }
    }

    private int MovedCount => Live?.MovedCount ?? Stream.MovedCount;
    private int TotalCount => Live?.TotalCount ?? Stream.TotalCount;

    private double ProgressPercent => Status == "Completed"
        ? 100
        : (TotalCount == 0 ? 0 : (double)MovedCount / TotalCount * 100);

    private bool HasPriorityTerms => !string.IsNullOrWhiteSpace(Stream.PriorityTerms);
    private bool HasDePriorityTerms => !string.IsNullOrWhiteSpace(Stream.DePriorityTerms);

    private IReadOnlyList<string> PriorityTermList =>
        SplitTerms(Stream.PriorityTerms);

    private IReadOnlyList<string> DePriorityTermList =>
        SplitTerms(Stream.DePriorityTerms);

    private static IReadOnlyList<string> SplitTerms(string csv) =>
        string.IsNullOrWhiteSpace(csv)
            ? Array.Empty<string>()
            : csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private string OverallSizeText
    {
        get
        {
            long bytes = Live?.TotalSizeBytes ?? 0;
            return bytes > 0 ? bytes.ToGigabytes().ToString("0.#") + " GB" : string.Empty;
        }
    }

    private string StatusMessage => Live?.StatusMessage ?? string.Empty;

    private bool HasClientInfo => Live is { ClientSizeBytes: > 0 };

    /// <summary>
    /// <summary>
    /// True when a rate limit is actually active on this stream's torrent. Prefers the live
    /// snapshot (refreshed every poll) and falls back to the persisted flag when no live
    /// snapshot is available yet.
    /// </summary>
    private bool IsRateLimited => Live?.IsRateLimited ?? Stream.IsRateLimited;

    private double ClientProgressPercent
    {
        get
        {
            if (Live is not { ClientSizeBytes: > 0 } || Live.ClientDownloadedBytes <= 0)
            {
                return 0;
            }
            return (double)Live.ClientDownloadedBytes / Live.ClientSizeBytes * 100;
        }
    }

    private string ClientSizeText
    {
        get
        {
            if (Live is not { ClientSizeBytes: > 0 })
            {
                return string.Empty;
            }
            return Live.ClientSizeBytes.ToGigabytes().ToString("0.##") + " GB";
        }
    }

    private string ClientState
    {
        get
        {
            var state = Live?.ClientState ?? string.Empty;
            // qBittorrent appends "DL"/"UP" to some states (e.g. "stalledDL", "pausedUP").
            // Strip the trailing suffix for a cleaner display.
            if (state.EndsWith("DL", StringComparison.OrdinalIgnoreCase))
            {
                return state[..^2];
            }
            if (state.EndsWith("UP", StringComparison.OrdinalIgnoreCase))
            {
                return state[..^2];
            }
            return state;
        }
    }

    private int ClientSeeds => Live?.ClientSeeds ?? 0;
    private int ClientPeers => Live?.ClientPeers ?? 0;

    private string ClientSeedsText
    {
        get
        {
            int connected = ClientSeeds;
            int total = Live?.ClientSeedsTotal ?? 0;
            return total > 0 ? $"{connected} ({total})" : connected.ToString();
        }
    }

    private string ClientPeersText
    {
        get
        {
            int connected = ClientPeers;
            int total = Live?.ClientPeersTotal ?? 0;
            return total > 0 ? $"{connected} ({total})" : connected.ToString();
        }
    }

    private string ClientEtaText
    {
        get
        {
            long eta = Live?.ClientEta ?? -1;
            if (eta < 0) return "—";
            long days = eta / 86400;
            long hours = (eta % 86400) / 3600;
            long minutes = (eta % 3600) / 60;
            long seconds = eta % 60;
            if (days > 0) return $"{days}d {hours:00}h {minutes:00}m {seconds:00}s";
            if (hours > 0) return $"{hours:00}h {minutes:00}m {seconds:00}s";
            if (minutes > 0) return $"{minutes:00}m {seconds:00}s";
            return $"{seconds:00}s";
        }
    }

    private string ClientSpeedText
    {
        get
        {
            long speed = Live?.ClientDownSpeed ?? 0;
            if (speed <= 0) return "—";
            if (speed < 1024) return $"{speed} B/s";
            if (speed < 1024 * 1024) return $"{speed / 1024.0:0.#} KB/s";
            if (speed < 1024L * 1024 * 1024) return $"{speed / (1024.0 * 1024):0.##} MB/s";
            return $"{speed / (1024.0 * 1024 * 1024):0.##} GB/s";
        }
    }

    private string ServerName => string.IsNullOrWhiteSpace(Live?.ServerName) ? Stream.ServerProfileId : Live!.ServerName;

    private string CreatedText => Stream.CreatedUtc == default ? string.Empty : $"Created {Stream.CreatedUtc.ToLocalTime():dd MMM yyyy}";

    private string CapText
    {
        get
        {
            if (Live is not { AllocatedCapBytes: > 0 })
            {
                return "—";
            }

            string size = Live.AllocatedCapBytes.ToGigabytes().ToString("0.#") + " GB";
            // "(set)" when the stream has an explicit per-stream cap override, "(auto)" when
            // it's the fair-share split of the server's cap.
            string source = Stream.SpoolingCapGb.HasValue ? "(set)" : "(auto)";
            return $"{size} {source}";
        }
    }

    private string DestinationText
    {
        get
        {
            // Explicit per-stream target takes precedence; otherwise the default target
            // with the torrent-name subfolder (mirrors SpoolingEngine.GetDestinationRoot).
            string containerPath;
            if (!string.IsNullOrWhiteSpace(Stream.SpoolingTargetOverride))
            {
                containerPath = Stream.SpoolingTargetOverride!;
            }
            else
            {
                // Use the real torrent name (from the live snapshot) so the path matches what
                // the engine actually writes. The torrent name may contain nested folder
                // segments (e.g. "Minerva_Myrient\Redump\Sony - PlayStation"). Fall back to the
                // friendly stream name only when no live torrent name is available.
                string folder = !string.IsNullOrWhiteSpace(Live?.TorrentName)
                    ? SanitizeFolderName(Live!.TorrentName)
                    : string.IsNullOrWhiteSpace(Stream.Name) ? Stream.TorrentIdentifier : Stream.Name;

                containerPath = System.IO.Path.Combine(Settings.DefaultSpoolingTarget, folder);
            }

            return SpoolPathDisplay.ToDisplayPath(Settings, containerPath) ?? containerPath;
        }
    }

    private static string SanitizeFolderName(string name)
    {
        var invalid = System.IO.Path.GetInvalidFileNameChars();
        var sanitized = new string(name.Select(c => invalid.Contains(c) ? '_' : c).ToArray());
        return string.IsNullOrWhiteSpace(sanitized) ? "stream" : sanitized;
    }

    private Color ProgressColor => Status switch
    {
        "Error" => Color.Error,
        "Completed" => Color.Success,
        "Paused" => Color.Warning,
        _ => Color.Primary
    };

    private string StatusIcon => Status switch
    {
        "Paused" => Icons.Material.Filled.PauseCircle,
        "Completed" => Icons.Material.Filled.CheckCircle,
        "Error" => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.PlayCircle
    };

    private Color StatusIconColor => Status switch
    {
        "Error" => Color.Error,
        "Completed" => Color.Success,
        "Paused" => Color.Warning,
        _ => Color.Primary
    };

    private IReadOnlyList<FileProgressInfo> Files => Live?.Files ?? (IReadOnlyList<FileProgressInfo>)Array.Empty<FileProgressInfo>();

    private int FileCount => Files.Count;

    private List<FileProgressInfo> _visibleFiles
    {
        get
        {
            IEnumerable<FileProgressInfo> source = _showDownloadingOnly
                ? Files.Where(f => f.Progress < 1.0f)
                : Files;

            // Sort by download percentage descending (100% / fully downloaded first).
            return source.OrderByDescending(f => f.Progress).ToList();
        }
    }

    private static string FileSizeText(FileProgressInfo file) =>
        file.SizeBytes <= 0 ? string.Empty : file.SizeBytes.ToGigabytes().ToString("0.##") + " GB";

    private string ActionLabel => Status switch
    {
        "Active" => "Pause",
        "Paused" => "Resume",
        "Error" => "Retry",
        _ => "Pause"
    };

    private string ActionIcon => Status switch
    {
        "Active" => Icons.Material.Filled.Pause,
        "Paused" => Icons.Material.Filled.PlayArrow,
        "Error" => Icons.Material.Filled.Refresh,
        _ => Icons.Material.Filled.Pause
    };

    private void ToggleFiles() => _expanded = !_expanded;
}
