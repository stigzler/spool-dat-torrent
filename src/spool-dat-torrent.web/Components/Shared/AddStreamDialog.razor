@using SpoolDatTorrent.Core.Configuration

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">

            @if (_fileError != null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_fileError</MudAlert>
            }

            <MudText Typo="Typo.subtitle2">Torrent</MudText>
            <MudTextField @bind-Value="_magnet"
                          Label="Magnet link / info-hash"
                          HelperText="Leave blank if uploading a .torrent file."
                          Variant="Variant.Outlined" FullWidth="true" />
            <MudFileUpload T="IBrowserFile" @ref="_torrentUpload" @bind-Files="_torrentFile" Accept=".torrent" DragAndDrop="true" Variant="Variant.Outlined" Class="w-100" OnFilesChanged="OnTorrentFileChanged">
                <SelectedTemplate>
                    @if (context is not null)
                    {
                        <MudChip T="string"
                                 Class="sdt-file-chip"
                                 Color="Color.Secondary"
                                 Text="@MiddleEllipsis(context.Name)"
                                 CloseIcon="@Icons.Material.Outlined.Close"
                                 OnClose="RemoveTorrentFile" />
                    }
                </SelectedTemplate>
            </MudFileUpload>



            <MudText Typo="Typo.subtitle2">DAT File</MudText>
            <MudFileUpload T="IBrowserFile" @ref="_datUpload" @bind-Files="_datFile" Accept=".dat,.xml,.lst" DragAndDrop="true" Variant="Variant.Outlined" Class="w-100" OnFilesChanged="OnDatFileChanged">
                <SelectedTemplate>
                    @if (context is not null)
                    {
                        <MudChip T="string"
                              Class="sdt-file-chip"
                              Color="Color.Secondary"
                              Text="@MiddleEllipsis(context.Name)"
                              CloseIcon="@Icons.Material.Outlined.Close"
                              OnClose="RemoveDatFile" />
                    }
                </SelectedTemplate>
            </MudFileUpload>

            <MudStack Row="true" Spacing="3">
                <MudSelect T="string" @bind-Value="_server"
                           @bind-Value:after="OnCapChanged"
                           Label="Server Profile"
                           HelperText="BitTorrent client used for this stream. Defaults to the configured default."
                           Variant="Variant.Outlined" FullWidth="true">
                    @foreach (var name in Settings.TorrentServers.Keys)
                    {
                        <MudSelectItem Value="@name">@name</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string" @bind-Value="_strategy"
                           Label="Strategy"
                           HelperText="MoveFiles: move each completed batch to the destination and continue. Pause: stop after the current batch and wait for manual resume. RateLimit: download at the global rate limit (Settings)."
                           Variant="Variant.Outlined" FullWidth="true">
                    <MudSelectItem Value="@SpoolingStrategy.MoveFiles.ToString()">MoveFiles</MudSelectItem>
                    <MudSelectItem Value="@SpoolingStrategy.Pause.ToString()">Pause</MudSelectItem>
                    <MudSelectItem Value="@SpoolingStrategy.RateLimit.ToString()">RateLimit</MudSelectItem>
                </MudSelect>
            </MudStack>

            <MudText Typo="Typo.subtitle1" Style="">Optional</MudText>


            <MudTextField @bind-Value="_name"
                          Label="Name (optional)"
                          HelperText="A friendly display name. Defaults to the uploaded torrent's filename."
                          Variant="Variant.Outlined" FullWidth="true" />

            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start">
                <MudSelect T="string" @bind-Value="_destinationRoot"
                           @bind-Value:after="OnDestinationChanged"
                           Label="Destination root"
                           Variant="Variant.Outlined"
                           Style="min-width: 200px;">
                    <MudSelectItem Value="@_noneKey">None (default)</MudSelectItem>
                    <MudSelectItem Value="@Settings.DefaultSpoolingTarget">staging-dir</MudSelectItem>
                    @if (_libraryAvailable)
                    {
                        <MudSelectItem Value="@_libraryRoot">library-dir</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_targetSubpath"
                              @bind-Value:after="OnDestinationChanged"
                              Label="Subfolder (optional)"
                              Variant="Variant.Outlined" FullWidth="true" />
            </MudStack>
            <MudText Typo="Typo.caption" Color="@(_destinationError != null ? Color.Error : Color.Default)">
                @DestinationHelperText
            </MudText>

            <MudStack Row="true" Spacing="3">
                <MudNumericField @bind-Value="_settlingTimeSeconds"
                                 Label="Settling Time (seconds, optional)"
                                 HelperText="How long to wait after pausing this stream's torrent before moving its completed files (lets the client finish writing). Leave blank to use the global default."
                                 Variant="Variant.Outlined" FullWidth="true"
                                 Min="1" Max="480" />
            </MudStack>

            <MudStack Row="true" Spacing="3">
                <MudTextField @bind-Value="_priorityTerms"
                              Label="Priority Terms (optional)"
                              HelperText="Download first, e.g. (USA),(Europe),(World). Slows performance."
                              Variant="Variant.Outlined" FullWidth="true" />
                <MudTextField @bind-Value="_dePriorityTerms"
                              Label="De-priority Terms (optional)"
                              HelperText="Download last, e.g. (Japan),(China). Slows performance."
                              Variant="Variant.Outlined" FullWidth="true" />
            </MudStack>

            <MudNumericField T="long?" @bind-Value="_spoolingCapGb"
                             @bind-Value:after="OnCapChanged"
                             Label="Spooling Cap (GB, optional)"
                             HelperText="@CapHelperText"
                             Variant="Variant.Outlined" FullWidth="true"
                             Min="1" />

        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Add" Disabled="!_isValid">Add Stream</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialogInstance { get; set; } = default!;

    [Inject] private GlobalSpoolSettings Settings { get; set; } = default!;
    [Inject] private Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env { get; set; } = default!;

    private string _name = string.Empty;
    private string _server = string.Empty;
    private string _destinationRoot = string.Empty;
    private string _targetSubpath = string.Empty;
    private string _strategy = SpoolingStrategy.MoveFiles.ToString();
    private string _magnet = string.Empty;
    private int? _settlingTimeSeconds;
    private string _priorityTerms = string.Empty;
    private string _dePriorityTerms = string.Empty;
    private long? _spoolingCapGb;
    private string? _capError;

    private const string _noneKey = "none";

    private bool _libraryAvailable;
    private string _libraryRoot = SpoolPaths.DefaultLibraryDir;

    protected override void OnInitialized()
    {
        // Default the server profile to the configured default so the user doesn't have to
        // pick one (and can't accidentally add a stream with no server).
        _server = Settings.DefaultServerProfile;
        _destinationRoot = _noneKey;

        _libraryAvailable = SpoolMountDetection.IsLibraryAvailable(Settings);
        _libraryRoot = string.IsNullOrWhiteSpace(Settings.LibraryDir)
            ? SpoolPaths.DefaultLibraryDir
            : Settings.LibraryDir;
    }

    private IBrowserFile? _torrentFile;
    private IBrowserFile? _datFile;
    private MudFileUpload<IBrowserFile>? _torrentUpload;
    private MudFileUpload<IBrowserFile>? _datUpload;
    private string? _destinationError;
    private string? _fileError;

    private static readonly string[] AllowedTorrentExtensions = [".torrent"];
    private static readonly string[] AllowedDatExtensions = [".dat", ".xml", ".lst"];

    private bool _isValid =>
        (_fileError == null) &&
        ((_torrentFile != null || !string.IsNullOrWhiteSpace(_magnet)) &&
        _datFile != null) &&
        _destinationError == null &&
        _capError == null;

    private string CapHelperText
    {
        get
        {
            if (_capError != null)
            {
                return _capError;
            }

            long serverCap = GetServerCapGb();
            return $"Maximum spool size for this stream. Leave blank to share the server's {serverCap} GB cap with other streams. Cannot exceed {serverCap} GB.";
        }
    }

    private long GetServerCapGb()
    {
        if (!string.IsNullOrWhiteSpace(_server) && Settings.TorrentServers.TryGetValue(_server, out var profile))
        {
            return profile.SpoolingCapGb;
        }
        return 0;
    }

    private void OnCapChanged()
    {
        _capError = ValidateCap(_spoolingCapGb);
    }

    private string? ValidateCap(long? capGb)
    {
        if (!capGb.HasValue)
        {
            return null;
        }

        if (capGb.Value <= 0)
        {
            return "Spooling cap must be greater than 0 GB.";
        }

        long serverCap = GetServerCapGb();
        if (serverCap > 0 && capGb.Value > serverCap)
        {
            return $"Spooling cap cannot exceed the server profile's cap of {serverCap} GB.";
        }

        return null;
    }

    private static bool HasAllowedExtension(IBrowserFile file, string[] allowed)
    {
        var ext = Path.GetExtension(file.Name);
        return allowed.Contains(ext, StringComparer.OrdinalIgnoreCase);
    }

    private async Task OnTorrentFileChanged(InputFileChangeEventArgs e)
    {
        _fileError = null;
        if (e.FileCount > 0 && HasAllowedExtension(e.File, AllowedTorrentExtensions))
        {
            _torrentFile = e.File;
        }
        else
        {
            _fileError = "Torrent file must be a .torrent file.";
            _torrentFile = null;
            if (_torrentUpload is not null)
            {
                await _torrentUpload.ClearAsync();
            }
        }
    }

    private async Task OnDatFileChanged(InputFileChangeEventArgs e)
    {
        _fileError = null;
        if (e.FileCount > 0 && HasAllowedExtension(e.File, AllowedDatExtensions))
        {
            _datFile = e.File;
        }
        else
        {
            _fileError = "DAT file must be a .dat, .xml, or .lst file.";
            _datFile = null;
            if (_datUpload is not null)
            {
                await _datUpload.ClearAsync();
            }
        }
    }

    private Task RemoveTorrentFile(MudChip<string> chip)
    {
        _torrentFile = null;
        return _torrentUpload?.ClearAsync() ?? Task.CompletedTask;
    }

    private Task RemoveDatFile(MudChip<string> chip)
    {
        _datFile = null;
        return _datUpload?.ClearAsync() ?? Task.CompletedTask;
    }

    // Truncate a filename in the middle (keeping the extension) so long names fit the
    // form, e.g. "A really long na...me.dat". CSS text-overflow can only ellipsis the end.
    private static string MiddleEllipsis(string? name, int maxLength = 128)
    {
        if (string.IsNullOrEmpty(name) || name.Length <= maxLength)
        {
            return name ?? string.Empty;
        }

        var ext = Path.GetExtension(name);
        var extLen = ext.Length;
        var keep = maxLength - 3; // room for "..."
        if (extLen >= keep)
        {
            // Extension is huge; just truncate the start to keep the extension.
            return "..." + name[^keep..];
        }

        var keepStart = (keep - extLen) / 2;
        var keepEnd = extLen;
        return name[..keepStart] + "..." + name[^keepEnd..];
    }

    /// <summary>
    /// The resolved override value to store, or null when "none" (or staging + no subpath)
    /// is selected - meaning the stream uses the default behavior.
    /// </summary>
    private string? ResolvedTarget
    {
        get
        {
            // "none" ? no override.
            if (string.Equals(_destinationRoot, _noneKey, StringComparison.OrdinalIgnoreCase))
            {
                return null;
            }

            var subpath = _targetSubpath.Trim().Trim('"').Trim('/', '\\');

            // staging-dir + empty subpath ? default (no override).
            if (string.Equals(_destinationRoot, Settings.DefaultSpoolingTarget, StringComparison.OrdinalIgnoreCase)
                && string.IsNullOrEmpty(subpath))
            {
                return null;
            }

            // library-dir + empty subpath ? the library root itself.
            if (string.Equals(_destinationRoot, _libraryRoot, StringComparison.OrdinalIgnoreCase)
                && string.IsNullOrEmpty(subpath))
            {
                return _libraryRoot;
            }

            return $"{_destinationRoot}/{subpath}";
        }
    }

    private string DestinationHelperText
    {
        get
        {
            if (_destinationError != null)
            {
                return _destinationError;
            }

            var target = ResolvedTarget;
            if (target == null)
            {
                var staging = SpoolPathDisplay.ToDisplayPath(Settings, Settings.DefaultSpoolingTarget)
                    ?? Settings.DefaultSpoolingTarget;
                return $"No override - files go to the default staging folder: {staging}";
            }

            var display = SpoolPathDisplay.ToDisplayPath(Settings, target);
            return $"Files will be moved to: {display}";
        }
    }

    private void OnDestinationChanged()
    {
        _destinationError = ValidateSubpath(_targetSubpath);
    }

    private static string? ValidateSubpath(string? subpath)
    {
        if (string.IsNullOrWhiteSpace(subpath))
        {
            return null; // empty is valid
        }

        var trimmed = subpath.Trim().Trim('"').Trim('/', '\\');

        if (trimmed.Contains('"') || trimmed.IndexOfAny(Path.GetInvalidPathChars()) >= 0)
        {
            return "Invalid subfolder - remove quotes or invalid characters.";
        }

        if (Path.IsPathRooted(trimmed))
        {
            return "Use a relative subfolder (no leading slash), e.g. psx";
        }

        var segments = trimmed.Split(['/', '\\'], StringSplitOptions.RemoveEmptyEntries);
        if (segments.Any(s => s == ".."))
        {
            return "Subfolder cannot contain '..'.";
        }

        return null;
    }

    private void Cancel() => MudDialogInstance.Close(DialogResult.Cancel());

    private async Task AddAsync()
    {
        string? torrentPath = null;
        string? datPath = null;

        try
        {
            var uploadDir = Path.Combine(Path.GetTempPath(), "sdt-uploads");
            Directory.CreateDirectory(uploadDir);

            if (_torrentFile != null)
            {
                torrentPath = Path.Combine(uploadDir, Guid.NewGuid().ToString("N") + ".torrent");
                await using (var fs = File.Create(torrentPath))
                {
                    await _torrentFile.OpenReadStream(maxAllowedSize: 1L * 1024 * 1024 * 1024).CopyToAsync(fs);
                }
            }

            if (_datFile != null)
            {
                datPath = Path.Combine(uploadDir, Guid.NewGuid().ToString("N") + ".dat");
                await using (var fs = File.Create(datPath))
                {
                    await _datFile.OpenReadStream(maxAllowedSize: 1L * 1024 * 1024 * 1024).CopyToAsync(fs);
                }
            }

            var result = new AddStreamForm
            {
                Name = string.IsNullOrWhiteSpace(_name) ? null : _name.Trim(),
                Server = string.IsNullOrWhiteSpace(_server) ? null : _server,
                Target = ResolvedTarget,
                Strategy = _strategy,
                SettlingTimeSeconds = _settlingTimeSeconds,
                PriorityTerms = string.IsNullOrWhiteSpace(_priorityTerms) ? null : _priorityTerms.Trim(),
                DePriorityTerms = string.IsNullOrWhiteSpace(_dePriorityTerms) ? null : _dePriorityTerms.Trim(),
                SpoolingCapGb = _spoolingCapGb,
                TorrentFilePath = torrentPath,
                OriginalTorrentName = _torrentFile?.Name,
                DatFilePath = datPath,
                OriginalDatName = _datFile?.Name,
                Magnet = string.IsNullOrWhiteSpace(_magnet) ? null : _magnet.Trim()
            };

            MudDialogInstance.Close(DialogResult.Ok(result));
        }
        catch (Exception ex)
        {
            MudDialogInstance.Close(DialogResult.Ok(new AddStreamForm { Error = ex.Message }));
        }
    }

    private void Add()
    {
        _ = AddAsync();
    }
}

