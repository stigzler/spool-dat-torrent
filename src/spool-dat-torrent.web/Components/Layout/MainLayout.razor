@using MudBlazor
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Components.Web
@inherits LayoutComponentBase
@implements IDisposable

<MudThemeProvider Theme="AppTheme.Theme" @bind-IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudImage Src="/icon-128px.png" Alt="SpoolDatTorrent Icon" Height="48" Class="ml-3 mr-2" Style="object-fit: contain;" />
        <MudText Typo="Typo.h6" Style="font-family: 'Rubik', sans-serif; font-weight: 500;">SpoolDatTorrent</MudText>
        <MudSpacer />
        <MudSwitch T="bool" @bind-Value="_isDarkMode" @bind-Value:after="() => ToggleDarkMode(_isDarkMode)"
                   Color="Color.Primary"
                   Label="@(_isDarkMode ? "Dark" : "Light")"
                   OnColor="Color.Success" />
        <MudIconButton Icon="@Icons.Material.Filled.ExitToApp" OnClick="Logout" Title="Log out" />
    </MudAppBar>

    <MudDrawer Open="true" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudNavMenu>
            <MudNavLink Href="streams" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ViewList">Streams</MudNavLink>
            <MudNavLink Href="clients" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dns">Servers</MudNavLink>
            <MudNavLink Href="spool" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PlayCircle">Spool / Pause</MudNavLink>
            <MudNavLink Href="about" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Info">About</MudNavLink>
            <MudNavLink Href="settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    [Inject]
    private IHttpContextAccessor HttpContextAccessor { get; set; } = default!;

    [Inject]
    private PersistentComponentState PersistentState { get; set; } = default!;

    private bool _isDarkMode;
    private PersistingComponentStateSubscription _subscription;

    protected override void OnInitialized()
    {
        // During prerender (server-side, before the interactive circuit), HttpContext IS
        // available. Read the cookie and persist it so the interactive client can restore
        // it without touching HttpContext (which is null there). This makes the theme
        // correct on the very first render — no light-mode flash.
        if (HttpContextAccessor.HttpContext is not null)
        {
            var cookie = HttpContextAccessor.HttpContext.Request.Cookies["sdt_darkmode"];
            _isDarkMode = bool.TryParse(cookie, out var dark) && dark;
            _subscription = PersistentState.RegisterOnPersisting(PersistDarkMode);
        }
        else
        {
            // Interactive client: restore from the persisted prerender state.
            if (PersistentState.TryTakeFromJson("sdt_darkmode", out bool dark))
            {
                _isDarkMode = dark;
            }
        }
    }

    private Task PersistDarkMode()
    {
        PersistentState.PersistAsJson("sdt_darkmode", _isDarkMode);
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Also keep localStorage in sync (used by the pre-paint background script in
            // App.razor and as a fallback).
            await JS.InvokeVoidAsync("localStorage.setItem", "sdt_darkmode", _isDarkMode.ToString());
        }
    }

    private async Task ToggleDarkMode(bool value)
    {
        _isDarkMode = value;
        var cookieValue = value.ToString();

        // Write both localStorage (pre-paint background script + fallback) and a cookie
        // (read by the server during prerender so the theme is correct on first render).
        // document.cookie is a property, not a function, so use eval to assign it.
        await JS.InvokeVoidAsync("localStorage.setItem", "sdt_darkmode", cookieValue);
        await JS.InvokeVoidAsync("eval", $"document.cookie = 'sdt_darkmode={cookieValue}; path=/; max-age=31536000'");

        // Keep the <html> background in sync so the old colour doesn't stay stuck behind
        // the page when toggling (the pre-paint script only runs once on load).
        await JS.InvokeVoidAsync("eval", $"document.documentElement.style.backgroundColor = '{(_isDarkMode ? "#1E1E1E" : "#F3F4F6")}'");
    }

    public void Dispose()
    {
        _subscription.Dispose();
    }

    private void Logout()
    {
        Navigation.NavigateTo("/auth/logout", forceLoad: true);
    }
}
